{
  "name": "iln-notifications",
  "version": "0.1.0",
  "description": "Notification service backend for Invoice Liquidity Network",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prepare": "husky install || true",
    "build": "tsc",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dead-code:check": "pnpm dead-code:check --filter iln-notifications"
  },
  "dependencies": {
    "resend": "^2.0.0",
    "twilio": "^5.0.0",
    "@iln/opentelemetry": "workspace:*",
    "@opentelemetry/api": "^1.4.0",
    "@stellar/stellar-sdk": "^15.0.1",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ws": "^8.17.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.0",
    "@commitlint/config-conventional": "^17.6.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^8.57.1",
    "@iln/eslint-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.0",
    "msw": "^2.2.14",
    "supertest": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
